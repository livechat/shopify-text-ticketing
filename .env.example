# Create a Personal Access Token in Text; it is sent as HTTP Basic auth.
# https://www.text.com/app/settings/integrations/api-access/personal-access-tokens/new
TEXT_ACCOUNT_ID=
TEXT_PAT=

# Public HTTPS URL of this service (the ngrok forwarding address in development), no trailing
# slash. Leave it empty until the tunnel is running: register:webhooks refuses to run without it,
# so webhooks are never pointed at a host you do not control.
PUBLIC_URL=
PORT=3000

# Client ID and secret of the app created in the Shopify Dev Dashboard. One app serves
# every store in the same organization; the key suffix must match `credentialsKey` in
# config/stores.json. Add another pair only for stores that live in a different organization.
SHOPIFY_ACME_CLIENT_ID=
SHOPIFY_ACME_CLIENT_SECRET=
